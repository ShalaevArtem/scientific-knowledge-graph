# Подключение к Neo4j. Скопируйте в .env и подставьте свои значения.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# LLM для извлечения сущностей и синтеза ответов (опционально: без ключа
# работают ingest/embed/поиск/граф; extract и сводки с цитатами — нет).
# Провайдер: anthropic либо openai (= любой OpenAI-совместимый API).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
# LLM_BASE_URL=            # для openai-совместимых (openrouter, deepseek, …)

# Модель эмбеддингов (fastembed, локально; менять вместе с размерностью
# vector-индекса chunk_embedding в schema/003_corpus.cypher)
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
