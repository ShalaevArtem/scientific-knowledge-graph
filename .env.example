# Подключение к Neo4j. Скопируйте в .env и подставьте свои значения.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# LLM для извлечения сущностей и синтеза ответов (опционально: без ключа
# работают ingest/embed/поиск/граф; extract и сводки с цитатами — нет).
# Провайдер: anthropic либо openai (= любой OpenAI-совместимый API).
#
# Вариант кейса — Yandex AI Studio (OpenAI-совместимый эндпоинт):
LLM_PROVIDER=openai
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_MODEL=gpt://<folder_id>/yandexgpt-lite/latest
LLM_MODEL_SYNTH=gpt://<folder_id>/yandexgpt/latest
LLM_API_KEY=
#
# Вариант Yandex AI Studio (нативный API вместо OpenAI-совместимого):
# LLM_PROVIDER=yandex
# LLM_MODEL=yandexgpt-lite/latest
# LLM_FOLDER_ID=<folder_id>
# LLM_API_KEY=…
#
# Вариант Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=sk-ant-…

# Модель эмбеддингов (fastembed, локально; менять вместе с размерностью
# vector-индекса chunk_embedding в schema/003_corpus.cypher)
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OCR при ingest (Tesseract): распознаёт страницы PDF без текстового слоя
# (сканы, картиночные вставки) и файлы-изображения. Выключен по умолчанию —
# медленный. Нужен установленный бинарь Tesseract + языковые данные rus+eng
# (положить rus/eng/osd.traineddata в .cache/tessdata или указать TESSDATA_PREFIX).
# SKG_OCR=1
# SKG_OCR_LANG=rus+eng
# SKG_OCR_DPI=300
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # если не в PATH

# RBAC (опционально): токены → пользователи. Роли: researcher | analyst | lead |
# admin | external («внешний партнёр» не видит внутренние категории: обзоры, доклады).
# Аудит действий пишется в logs/audit.jsonl; администратору доступна вкладка «Аудит».
# AUTH_TOKENS={"tok-admin": {"name": "Иванов И.И.", "role": "admin"}, "tok-ext": {"name": "Партнёр", "role": "external"}}
# Роль анонимного доступа (по умолчанию researcher; deny — запретить без токена):
# AUTH_OPEN_ROLE=researcher
